# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use a local SQLite file (dev only, zero setup).
# Any postgres:// or postgresql:// prefix is rewritten onto the psycopg v3
# driver automatically, so connection strings paste in exactly as given.
#
# SUPABASE: use the TRANSACTION pooler (port 6543) here. Not the direct
# connection — that is IPv6-only on new projects and unreachable from
# IPv4-only hosts such as Render's free tier.
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# SUPABASE: the SESSION pooler (same host, port 5432), used only by Alembic.
# The transaction pooler cannot hold the session state and advisory locks
# migrations need, so running them through it hangs or half-applies. Leave
# blank for any other Postgres — it then falls back to DATABASE_URL.
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_MIGRATION_URL=

# ---------------------------------------------------------------------------
# Firebase Admin (server-side ID token verification)
# ---------------------------------------------------------------------------
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. That downloads a JSON file. Supply it EITHER as a path:
FIREBASE_CREDENTIALS_FILE=
# ...OR paste the whole JSON on one line (use this on Render):
FIREBASE_CREDENTIALS_JSON=

# Your Firebase project id, e.g. asm-lungi-works
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Auth behaviour
# ---------------------------------------------------------------------------
# DANGER: when true, the API skips Firebase verification entirely and treats
# every request as the seeded admin. Local development only. Never set this
# to true on Render or any deployed environment.
AUTH_DEV_BYPASS=false

# Emails granted the admin role on first login, comma separated. Use this to
# bootstrap the very first admin account (there is no public registration).
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# CORS — the frontend origins allowed to call this API, comma separated.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
