# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use a local SQLite file (dev only, zero setup).
# For Postgres (local or Render), use the psycopg v3 driver:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Render gives you an "Internal Database URL" starting with postgres:// —
# the app rewrites that prefix automatically, so you can paste it as-is.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Firebase Admin (server-side ID token verification)
# ---------------------------------------------------------------------------
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. That downloads a JSON file. Supply it EITHER as a path:
FIREBASE_CREDENTIALS_FILE=
# ...OR paste the whole JSON on one line (use this on Render):
FIREBASE_CREDENTIALS_JSON=

# Your Firebase project id, e.g. asm-lungi-works
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Auth behaviour
# ---------------------------------------------------------------------------
# DANGER: when true, the API skips Firebase verification entirely and treats
# every request as the seeded admin. Local development only. Never set this
# to true on Render or any deployed environment.
AUTH_DEV_BYPASS=false

# Emails granted the admin role on first login, comma separated. Use this to
# bootstrap the very first admin account (there is no public registration).
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# CORS — the frontend origins allowed to call this API, comma separated.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
