# Base URL of the FastAPI backend.
# Leave blank in local dev to use the Vite proxy (vite.config.ts -> :8000).
# On Vercel, set this to your Render URL, e.g. https://asm-api.onrender.com
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Firebase Web SDK config
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These values are public by design; they identify the project, they do not
# authorise anything. Access control lives in the backend and Firebase rules.
#
# Leave these blank to run in DEV MODE: the login screen is skipped and the
# app talks to a backend running with AUTH_DEV_BYPASS=true. A banner is shown
# so this state is never mistaken for a working login.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
